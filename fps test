import argparse
import csv
import statistics
import time

import cv2
from ultralytics import YOLO


def main():
    parser = argparse.ArgumentParser(description="Sustained FPS test on the target board (T2)")
    parser.add_argument("--weights", required=True, help="best.engine (TensorRT) or best.pt")
    parser.add_argument("--source", default="test_video.mp4", help="video file, or a camera index such as 0")
    parser.add_argument("--seconds", type=float, default=60)
    parser.add_argument("--conf", type=float, default=0.45)
    parser.add_argument("--imgsz", type=int, default=640)
    parser.add_argument("--target", type=float, default=20)
    parser.add_argument("--log", default="fps_log.csv")
    args = parser.parse_args()

    model = YOLO(args.weights, task="detect")
    source = int(args.source) if args.source.isdigit() else args.source
    cap = cv2.VideoCapture(source)
    if not cap.isOpened():
        print("Cannot open", args.source)
        return

    def read_frame():
        ok, frame = cap.read()
        if not ok and not isinstance(source, int):
            cap.set(cv2.CAP_PROP_POS_FRAMES, 0)
            ok, frame = cap.read()
        return ok, frame

    for _ in range(20):
        ok, frame = read_frame()
        if ok:
            model(frame, imgsz=args.imgsz, conf=args.conf, verbose=False)

    frame_ms, per_second, rows = [], [], []
    start = time.perf_counter()
    second_start, second_count = start, 0
    while time.perf_counter() - start < args.seconds:
        t0 = time.perf_counter()
        ok, frame = read_frame()
        if not ok:
            break
        result = model(frame, imgsz=args.imgsz, conf=args.conf, verbose=False)[0]
        t1 = time.perf_counter()
        frame_ms.append((t1 - t0) * 1000)
        rows.append([round(t1 - start, 3), round((t1 - t0) * 1000, 2), len(result.boxes)])
        second_count += 1
        if t1 - second_start >= 1.0:
            per_second.append(second_count / (t1 - second_start))
            second_start, second_count = t1, 0
    elapsed = time.perf_counter() - start
    cap.release()

    with open(args.log, "w", newline="") as f:
        w = csv.writer(f)
        w.writerow(["t_s", "frame_ms", "boxes"])
        w.writerows(rows)

    if not frame_ms:
        print("No frames processed")
        return
    mean_fps = len(frame_ms) / elapsed
    min_fps = min(per_second) if per_second else mean_fps
    verdict = "PASS" if min_fps >= args.target else "FAIL"
    print(f"\nWeights:            {args.weights}")
    print(f"Duration:           {elapsed:.1f} s, {len(frame_ms)} frames")
    print(f"Mean FPS:           {mean_fps:.1f}")
    print(f"Lowest 1-s FPS:     {min_fps:.1f}  (target {args.target:.0f})  -> {verdict}")
    print(f"Median frame time:  {statistics.median(frame_ms):.1f} ms (read + inference + post-processing)")
    print(f"Log:                {args.log}")


if __name__ == "__main__":
    main()